---
import { buttonVariants } from "@/components/ui/button";
import { SITE } from "@/data/site";
import { cn } from "@/lib/utils";

const { emphasized = false } = Astro.props as { emphasized?: boolean };
---

<a
  class={cn(
    buttonVariants({ variant: "outline", size: "touch" }),
    "shrink-0 gap-2 font-semibold text-primary hover:text-primary",
    emphasized &&
      "border-transparent bg-brand-action text-brand-action-foreground shadow-brand-action hover:bg-brand-action/90 hover:text-brand-action-foreground",
  )}
  href={SITE.facebookGroup}
  target="_blank"
  rel="noopener"
>
  {/* Facebook's own logo; the white circle fills the cut-out f. */}
  <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="11.5" class="fill-facebook-foreground" />
    <path
      class="fill-facebook"
      d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"
    />
  </svg>
  {/* The narrow header shows only "Join"; the accessible name stays whole. */}
  <span>
    Join
    <span class:list={[!emphasized && "max-[30rem]:sr-only"]}>
      {/* The leading space is a string, so HTML compression keeps it. */}
      {" our Facebook group"}
    </span>
  </span>
</a>
