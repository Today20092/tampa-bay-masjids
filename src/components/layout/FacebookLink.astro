---
import { SITE } from "@/data/site";

const { emphasized = false } = Astro.props as { emphasized?: boolean };
---

<a
  class:list={[
    "inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold",
    emphasized
      ? "border border-transparent bg-brand-action text-brand-action-foreground shadow-brand-action transition-all hover:bg-brand-action/90 active:translate-y-px active:shadow-pressed"
      : "text-primary hover:bg-muted",
  ]}
  href={SITE.facebookGroup}
  target="_blank"
  rel="noopener"
>
  <svg
    aria-hidden="true"
    class="size-4 shrink-0"
    fill="currentColor"
    viewBox="0 0 24 24"
  >
    <path d="M14 21v-8h3l.5-3H14V8.2c0-.9.3-1.5 1.6-1.5H18V4.1c-.5-.1-1.5-.2-2.7-.2-2.8 0-4.7 1.7-4.7 4.8V10H8v3h2.6v8z" />
  </svg>
  Join our Facebook group
</a>
