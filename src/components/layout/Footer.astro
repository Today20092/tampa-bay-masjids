---
import FacebookLink from "./FacebookLink.astro";
import { SITE } from "@/data/site";
import { addMasjidUrl } from "@/lib/links";
---

<footer id="community" class="site-shell pb-6">
  <div class="on-primary flex flex-wrap items-end justify-between gap-5 rounded-xl bg-primary p-5 text-primary-foreground sm:p-6">
    <div class="max-w-lg">
      <p class="text-sm font-semibold">Tampa Bay Muslims on Facebook</p>
      <p class="mt-2 text-xl font-semibold sm:text-2xl">
        Connect with your community
      </p>
      <p class="mt-2 text-sm leading-relaxed">
        Join the group to connect with Muslims across Tampa Bay.
      </p>
    </div>
    <FacebookLink emphasized />
  </div>
  <div class="mt-3 flex flex-col gap-2 text-sm sm:flex-row sm:gap-5">
    <a
      class="inline-flex min-h-11 items-center gap-2 font-semibold text-primary underline"
      href={`mailto:${SITE.reportEmail}?subject=${encodeURIComponent("Wrong time report")}`}
    >
      <svg
        aria-hidden="true"
        class="size-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
      Report a wrong time
    </a>
    <a
      class="inline-flex min-h-11 items-center gap-2 font-semibold text-primary underline"
      href={addMasjidUrl}
    >
      <svg
        aria-hidden="true"
        class="size-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
      Suggest a masjid to add
    </a>
  </div>
</footer>
