---
import FacebookLink from "./FacebookLink.astro";
import { SITE } from "@/data/site";
---

<footer class="mx-auto flex max-w-xl flex-col items-center gap-1 px-3 pt-1 pb-5">
  <FacebookLink />
  <p class="text-center text-xs text-muted-foreground">
    Report a wrong time:{" "}
    <a
      class="inline-flex min-h-11 items-center font-semibold break-all text-primary underline"
      href={`mailto:${SITE.reportEmail}`}
    >
      {SITE.reportEmail}
    </a>
  </p>
</footer>
