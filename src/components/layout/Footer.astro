---
import FacebookLink from "./FacebookLink.astro";
import { SITE } from "@/data/site";
---

<footer class="site-shell pb-6">
  <div class="on-primary flex flex-wrap items-center justify-between gap-4 rounded-xl bg-primary p-4 text-primary-foreground sm:p-6">
    <p class="text-lg font-semibold">Tampa Bay Masjids community</p>
    <FacebookLink emphasized />
  </div>
  <a
    class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary underline"
    href={`mailto:${SITE.reportEmail}`}
  >
    <svg
      aria-hidden="true"
      class="size-4 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </svg>
    Report a wrong time
  </a>
</footer>
