---
import { SITE } from "@/data/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/social-preview.png", canonical);
const shareImageAlt = "Tampa Bay Masjids — Iqama, Jumu‘ah, and directions";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="text-scale" content="scale" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex" />
) : (
  <link rel="canonical" href={canonical} />
)}
<meta name="color-scheme" content="light dark" />
<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content="#174c40"
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content="#0f1714"
/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link
  rel="alternate"
  type="text/plain"
  href="/llms.txt"
  title="Prayer times as plain text"
/>
<link
  rel="alternate"
  type="application/json"
  href="/masjids.json"
  title="Prayer times as JSON"
/>
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={shareImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={shareImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImage} />
<meta name="twitter:image:alt" content={shareImageAlt} />
