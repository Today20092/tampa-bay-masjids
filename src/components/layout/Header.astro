---
import FacebookLink from "./FacebookLink.astro";
import { SITE } from "@/data/site";
---

<header class="border-b bg-card">
  {/* Wraps, so enlarged text moves the link down instead of squeezing the name. */}
  <div class="site-shell flex min-h-16 flex-wrap items-center justify-between gap-2 py-2 sm:min-h-18">
    <div class="flex min-w-0 items-center gap-2 sm:gap-3">
      <img
        src="/logo-mark.svg"
        alt=""
        width="32"
        height="32"
        class="shrink-0 min-[22.5rem]:size-9 sm:size-11"
      />
      <h1 class="text-base font-semibold text-primary min-[22.5rem]:text-lg sm:text-2xl">
        {SITE.name}
      </h1>
    </div>
    <FacebookLink />
  </div>
</header>
