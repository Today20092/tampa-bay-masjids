---
import FacebookLink from "./FacebookLink.astro";
import { SITE } from "@/data/site";
---

<header class="border-b bg-card">
  <div class="site-shell flex items-center justify-between gap-x-3 py-2 sm:gap-x-5 sm:py-3">
    <div class="flex min-w-0 items-center gap-3">
      <img src="/favicon.svg" alt="" width="36" height="36" class="shrink-0" />
      <h1 class="text-base font-semibold tracking-tight min-[22.5rem]:text-lg sm:text-2xl">
        {SITE.name}
      </h1>
    </div>
    <FacebookLink />
  </div>
</header>
