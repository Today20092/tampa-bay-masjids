---
import { buttonVariants } from "@/components/ui/button";
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyTitle,
} from "@/components/ui/empty";
import { SITE } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Page not found · ${SITE.name}`}
  description={SITE.description}
  noindex
>
  <Empty className="gap-3 px-0 py-10 md:py-10">
    <EmptyHeader className="gap-3">
      <EmptyTitle className="text-lg font-bold">
        <h2>Page not found</h2>
      </EmptyTitle>
      <EmptyDescription className="text-foreground">
        This address has no page. All masjids are on the home page.
      </EmptyDescription>
    </EmptyHeader>
    <EmptyContent>
      <a class={buttonVariants({ size: "touch" })} href="/">
        See all masjids
      </a>
    </EmptyContent>
  </Empty>
</BaseLayout>
