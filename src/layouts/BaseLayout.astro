---
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SeoHead from "@/components/layout/SeoHead.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead {...Astro.props} />
  </head>
  <body>
    <Header />
    <main class="mx-auto max-w-xl p-2.5">
      <slot />
    </main>
    <Footer />
  </body>
</html>
