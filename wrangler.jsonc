{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tampa-bay-masjids",
  "account_id": "de011be818652cd288a0b1d934502de3",
  "compatibility_date": "2026-11-01",
  // Static assets only: no Worker script, bindings or database.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "masjids.ayoubabed.xyz", "custom_domain": true }],
  // Production stays on the custom domain only. Each PR branch gets a public workers.dev preview.
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
}
